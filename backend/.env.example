# Copy to backend/.env and fill in. Never commit real keys.

# Gemini API key used by the ADK agent, image/audio transcription, quizzes, and TTS.
# The process reads GEMINI_API_KEY. GOOGLE_API_KEY is set from it at startup if unset.
GEMINI_API_KEY=

# Opik full traces. Leave blank to run without a trace backend.
# Cloud: https://www.comet.com/opik
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=educator-rag

# Self-hosted Opik only. Example: http://localhost:5173/api
OPIK_URL_OVERRIDE=

# Local runtime. Do not point these at production services.
APP_HOST=127.0.0.1
APP_PORT=8000
